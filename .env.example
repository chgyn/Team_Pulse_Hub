# ==============================================================================
# Team Pulse Hub — Environment Configuration
# ==============================================================================

# API-Football v3 API Key (https://v3.football.api-sports.io/)
# SERVER-SIDE ONLY: Never expose with NEXT_PUBLIC_ prefix
FOOTBALL_API_KEY=""

# Clube Padrão do Painel: 127 (Flamengo)
NEXT_PUBLIC_DEFAULT_TEAM_ID="127"

# Liga Padrão: 71 (Brasileirão Série A)
NEXT_PUBLIC_DEFAULT_LEAGUE_ID="71"

# Temporada Atual / Vigente
NEXT_PUBLIC_SEASON="2026"

# Segredo para purga de cache sob demanda via POST /api/revalidate
REVALIDATION_SECRET="pulse_hub_revalidate_secure_token_2026"

# PostgreSQL connection strings (Compatível com Vercel / Neon / Supabase Connection Pooling)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/team_pulse_hub?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/team_pulse_hub?schema=public"

# Redis URL (Upstash / Local para BullMQ)
REDIS_URL="redis://localhost:6379"
